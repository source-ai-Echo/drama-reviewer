# 选择：openai / compatible / local
DRAMA_PROVIDER=openai

# 模型名称由使用者自行选择
DRAMA_MODEL=gpt-5-mini

# OpenAI 使用 OPENAI_API_KEY；不要把真实值提交到 GitHub
OPENAI_API_KEY=

# 第三方 OpenAI 兼容接口示例
# DRAMA_PROVIDER=compatible
# DRAMA_MODEL=your-model-name
# DRAMA_API_BASE=https://your-provider.example/v1
# DRAMA_API_KEY_ENV=DRAMA_API_KEY
# DRAMA_API_KEY=

# 本地兼容模型示例（默认地址适用于常见本地服务）
# DRAMA_PROVIDER=local
# DRAMA_MODEL=your-local-model
# DRAMA_API_BASE=http://127.0.0.1:11434/v1

# 兼容接口默认关闭 Agent 二次工具调用；知识案例仍会由程序预检索
# DRAMA_MODEL_TOOLS=false

# 可选：接入你自己的本地案例库。目录必须包含 manifests/corpus.json
# DRAMA_CORPUS_ROOT=/absolute/path/to/your-corpus
